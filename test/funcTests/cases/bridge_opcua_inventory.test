#
# The bridge's inventory - GET /admin/bridges/opcua/inventory (bridge ABI 14): the server's node tree, for a
# mapping tool to choose Channels and AssetChannels from. ?from= a NodeId (none: the Objects folder), ?depth=
# how many levels (the bridge caps it at 5). A server lost during a read is a 503, never a 404 - which of
# open62541's two codes for it (the SecureChannel or the connection closed) depends on what it sees first. A Variable with its DataType, whether it can be written, its
# unit and its value; a node the depth cut short says it has children.
#
# REQUIRE_FEATURE: BRIDGE_INVENTORY
#
--NAME--
opcua bridge - the inventory: the server's node tree from a NodeId, to a depth; 404 no such node, 503 a server lost

--TAGS--
bridge opcua admin

--INIT--
rm -rf "${OPCUA_TEST_DIR:?}"
mkdir -p "$OPCUA_TEST_DIR"
cat > $OPCUA_TEST_DIR/bridges.json <<J
{ "opcua": { "server": { "url": "opc.tcp://localhost:$OPCUA_SERVER_PORT" } } }
J
serverStart
brokerStart --apiPlugins admin

--RUN--
echo "01. The press, one level: its children, the ones with children of their own say so"
echo "==================================================================================="
inventory 'from=ns%3D2%3Bs%3DPress17'
echo
echo


echo "02. The press, three levels: every Variable with its DataType, writable, unit and value"
echo "======================================================================================="
inventory 'from=ns%3D2%3Bs%3DPress17&depth=3'
echo
echo


echo "03. No such node: 404"
echo "====================="
inventory 'from=ns%3D2%3Bs%3DNope'
echo
echo


echo "04. The server dies while the bridge reads: 503 - the node is not said to be missing"
echo "======================================================================================"
inventoryServerDies 'from=ns%3D2%3Bs%3DPress17'
echo
echo


echo "05. No server - the bridge cannot reconnect: 503, and why, within 5 s"
echo "===================================================================="
inventoryAwait 'from=ns%3D2%3Bs%3DPress17' 'cannot be reached' 5     # a reconnect is tried every 2 s
echo
echo


--TEARDOWN--
brokerStop
serverStop
rm -f "${OPCUA_TEST_DIR:?}/bridges.json" "$OPCUA_TEST_DIR/server.cmd"

--EXPECT--
